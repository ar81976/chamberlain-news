{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node stamp.cjs",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/hls/(.*).m3u8",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.apple.mpegurl"
        }
      ]
    },
    {
      "source": "/hls/(.*).ts",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp2t"
        }
      ]
    },
    {
      "source": "/fully.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Fully-Kiosk-Browser.apk\""
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/fully",
      "destination": "/fully.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/t",
      "destination": "/t.html"
    }
  ]
}
